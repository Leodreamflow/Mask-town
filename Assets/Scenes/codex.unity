--- !u!114 &506246160
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 506246159}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 681caa29b0f84bd4ba24b26e63799693, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemPrefab: {fileID: 6350813062976718793, guid: 533f45ab25da20b4aa92c0e92546263a, type: 3}
  itemParent: {fileID: 1553811589}
  descriptionText: {fileID: 1056418379}
  itemInfos:
  - name: 'Critic Mask  Visibility: High Engagement: High '
    sprite: {fileID: 21300000, guid: 1835d9081183d924cb93c9c4377e2fcc, type: 3}
    description: "Personality:  Highly opinionated, confident in their tastes, and
      eager to criticize.  \u201CA keyboard monarch\u2014may his words bring more
      than just bitter complaints.\u201D "
  - name: 'Drifter Mask  Visibility: Low Engagement: High '
    sprite: {fileID: 21300000, guid: fb972f33a43f0904f867b8b90a7d6fe3, type: 3}
    description: "Personality:  Follower of trends, easily swayed by others\u2019
      opinions.  \u201COne of the countless grains swept along the tides of the internet.\u201D "
  - name: 'Advocate Mask  Visibility: Low Engagement: High '
    sprite: {fileID: 21300000, guid: 0d43c6458a02d0847b2495aa340dffbe, type: 3}
    description: "Personality:  Loyal supporter, vocal in defending their beliefs
      and those they admire.  \u201CA devoted follower, standing firm in their virtual
      faith.\u201D  "
  - name: 'Brute Mask  Visibility: High Engagement: High '
    sprite: {fileID: 21300000, guid: 1d0fb68aa88b1d847954b923db2bc945, type: 3}
    description: "Personality:  Aggressive, thrives on confrontation, and uses harsh
      and offensive language.  \u201CWords can cut as deeply as blades\u2014he knows
      exactly how to wield them.\u201D  "
  - name: 'Lurker Mask  Visibility: Very Low Engagement: Very Low '
    sprite: {fileID: 21300000, guid: ef5edfe9ce5f3e14fa0d9ec61ee69190, type: 3}
    description: "Personality: Shy, introverted, and prefers observing from the shadows. 
      \u201CA timid diver in the vast ocean of the internet.\u201D  "
  - name: 'Observer Mask  Visibility: Medium Engagement: Low '
    sprite: {fileID: 21300000, guid: 043dff8ff06a0f344872b6755bf772ee, type: 3}
    description: "Personality: Quiet and reflective, prefers to watch and analyze
      rather than participate.  \u201CA silent witness, documenting the pulse of
      the digital age.\u201D  "
  - name: 'Jester Mask  Visibility: Medium Engagement: Medium '
    sprite: {fileID: 21300000, guid: 015f9963ba71a074995bf6797cce0b1a, type: 3}
    description: "Personality:  Enjoys stirring conflict for amusement, constantly
      fueling disputes.  \u201CHe plants the seeds of discord and revels in the chaos
      that blooms.\u201D  "
  - name: 'Sensualist Mask  Visibility: Medium Engagement: Medium '
    sprite: {fileID: 21300000, guid: dfcd86cf162626246b71988e9efb34f1, type: 3}
    description: "Personality:  Obsessed with sexual content, often adopting flattering
      or vulgar language.  \u201CLost in the digital mist, chasing the shadow of
      virtual desires.\u201D  "
  - name: 'Debater Mask  Visibility: Medium Engagement: Very High '
    sprite: {fileID: 21300000, guid: 83ba05aa6ed804c40b4dc0e09dac350a, type: 3}
    description: "Personality:  Logical and stubborn, naturally engaging with opposing
      opinions.  \u201COnce the spark of argument is ignited, it\u2019s impossible
      to extinguish.\u201D  "
  - name: 'Know-It-All Mask  Visibility: Medium Engagement: High '
    sprite: {fileID: 21300000, guid: e1c850082a474224fa7c13689064c157, type: 3}
    description: "Personality:  Comments on everything with unearned confidence,
      even in areas outside their expertise.  \u201CTo the uninformed, he is a sage;
      to the knowledgeable, merely a charlatan.\u201D   "
  - name: 'Sunlight Mask  Visibility: Medium Engagement: Medium '
    sprite: {fileID: 21300000, guid: 7ce8be58f8f196b4783cb17e1149270b, type: 3}
    description: "Personality:  Driven by a sense of justice, vocal in defending
      their idea of what is right.  \u201CA radiant sun, shining the light of their
      beliefs in the name of justice.\u201D  "
  - name: 'Celebrity Mask  Visibility: Very High Engagement: Very High '
    sprite: {fileID: 21300000, guid: 3254b416392bf6a4da99cc9265ec63e8, type: 3}
    description: "Personality:  Popular and charismatic, these users shine brightly
      but risk losing themselves in the limelight.  \u201CA dazzling star in the
      digital sky\u2014if lost in virtual applause, only a false trail remains.\u201D  "
  - name: "Moon Mask  Visibility: Medium Engagement: Medium \t\t "
    sprite: {fileID: 21300000, guid: 17ff5e3a2c89cdc44822bc943ccdacc5, type: 3}
    description: "Personality:  Melancholic and pessimistic, often posting negative
      or nihilistic views.  \u201CA lonely moon\u2014perhaps only a clever disguise
      for self-indulgent sorrow.\u201D   "
  - name: "\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1"
    sprite: {fileID: 21300000, guid: 43827d41ccb888846bb2354d8e66de55, type: 3}
    description: "\u2B1B\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1\u25A1"
