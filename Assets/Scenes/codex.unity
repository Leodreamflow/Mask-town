  m_Script: {fileID: 11500000, guid: 681caa29b0f84bd4ba24b26e63799693, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemPrefab: {fileID: 6350813062976718793, guid: 533f45ab25da20b4aa92c0e92546263a, type: 3}
  itemParent: {fileID: 246164584}
  descriptionText: {fileID: 94926579}
  itemInfos:
  - name: Info-001
    sprite: {fileID: 21300000, guid: 2df5d72b07b81b349af07a374e99182a, type: 3}
    description: A new TV series "Mystery of Mask Town" premieres.
  - name: News-001-1
    sprite: {fileID: 21300000, guid: 547ad12d73724b140b8270389e0e75af, type: 3}
    description: The viewership of "Mystery of Mask Town" broke records,second season
      is already commissioned.
  - name: News-001-2
    sprite: {fileID: 21300000, guid: 2a027e4617c311245b7655a85e09bd21, type: 3}
    description: Due to poor reception , the series has been cancelled.
  - name: Info-002
    sprite: {fileID: 21300000, guid: c59ecd19bf6096c47b205d2dd88474d4, type: 3}
    description: Celebrity mask runs for Mayor of mask town.
  - name: News-002-1
    sprite: {fileID: 21300000, guid: 1234737ec98a6ba4db267afd45a01531, type: 3}
    description: Celebrity mask become new mayor of mask town.
  - name: News-002-2
    sprite: {fileID: 21300000, guid: 5924f3a0d5c47fc4daa62e99d0ae8d05, type: 3}
    description: Celebrity mask's approval drops rapidly,and the campaign fails.
  - name: Info-003
    sprite: {fileID: 21300000, guid: 3f5ac7a3f43c0044db7f28c5c376349a, type: 3}
    description: Mask town plan to use social data to train new digtal masked.
  - name: News-003-1
    sprite: {fileID: 21300000, guid: b70ca5897bea048448bfb2cb98b1cf3c, type: 3}
    description: New masked trained from social data appears .
  - name: News-003-2
    sprite: {fileID: 21300000, guid: 2a0a6cffaf5ac9b4788773c14a63a5eb, type: 3}
    description: Following user protests, the training program is cancelled.
  - name: Indo-004
    sprite: {fileID: 21300000, guid: bdf58db4f5bfab2439e5b0ce9a4e431d, type: 3}
    description: Mask Town begins charging a membership fee.
  - name: News-004-1
    sprite: {fileID: 21300000, guid: b423259ae0255ec4dba1fc39471db443, type: 3}
    description: Some masks leave Mask Town because they do not want or are unable
      to pay the membership fee.
  - name: News-004-2
    sprite: {fileID: 21300000, guid: a02a7a657f6e53241b9ead9d0ace1224, type: 3}
    description: Basic rights in Mask Town remain available without a membership
      fee.
  - name: Info-005
    sprite: {fileID: 21300000, guid: 9105d84b5507ce5469c6001cde71bfb3, type: 3}
    description: Mask town is accused of manipulating public opinion.
  - name: News-005-1
    sprite: {fileID: 21300000, guid: b5c03d1fe4bb08c40ba093047e38b999, type: 3}
    description: The platform denies the accusation and restricts related keywords,the
      platform continues operating under stable conditions.
  - name: News-005-2
    sprite: {fileID: 21300000, guid: 097cc6a3e5173084580c4c82bc1a15d4, type: 3}
    description: The platform denies the accusation and restricts related keywords,some
      masks leave Mask Town following the incident.
  displayNumber: 15
  itemSpace: 470
  moveSmooth: 0.9
  dragSpeed: 2
  scaleMultiplying: 0.0004
  alphaMultiplying: 0.0008
