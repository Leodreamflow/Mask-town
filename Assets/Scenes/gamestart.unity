MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1107947394}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5f0414213d895e4cb083597d06737dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 464783250}
  clickNextButton: {fileID: 2003352988}
  choicePanel: {fileID: 991199713}
  choicePrefab: {fileID: 2265342369411486358, guid: fd46cc1408e582f4d9ad7ed1b5ff36d6, type: 3}
  choiceParent: {fileID: 1305166900}
  nodes:
  - text: "\rLoading......"
    choices: []
  - text: 'Welcome to Mask Town.

      You have been nominated as a potential Administrator.'
    choices: []
  - text: At least you are not late.
    choices: []
  - text: Before authority can be granted, you must complete a brief evaluation.
    choices: []
  - text: Please answer honestly. Your future influence depends on it.
    choices: []
  - text: 'Behavioral Assessment

      Loading......'
    choices: []
  - text: How frequently do you browse social networks?
    choices:
    - text: ' I rarely use them.'
    - text: ' I browse occasionally, but not often.'
    - text: I check them daily.
    - text: I am almost always online.
    - text: I refresh more often than I reflect.
  - text: How active are you in online interactions?
    choices:
    - text: ' I rarely speak or engage.'
    - text: I occasionally like or comment.
    - text: I frequently participate in discussions.
    - text: I actively initiate topics and controversy.
    - text: My existence is sustained by engagement metrics.
  - text: 'Cognitive Evaluation

      Loading......'
    choices: []
  - text: "If a piece of content is not seen,does it still exist?\r"
    choices:
    - text: Yes, it exists without being seen.
    - text: It only exists when it is seen.
    - text: ' Its existence is determined by the platform.'
    - text: ' Increasing exposure is the only solution.'
  - text: "If conflict increases engagement,should conflict be manufactured?\r\n\r"
    choices:
    - text: No, stability is more important.
    - text: It depends.
    - text: Yes, engagement is everything.
    - text: ' If it can be monetized, it is worth it. '
  - text: "System Calculating\u2026"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026\nCalculating
      your engagement drive index\u2026\n"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026\nCalculating
      your engagement drive index\u2026\nEvaluating your compatibility with capital
      logic\u2026\n"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026\nCalculating
      your engagement drive index\u2026\nEvaluating your compatibility with capital
      logic\u2026\nAnalyzing your tolerance for algorithmic intervention\u2026\n"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026\nCalculating
      your engagement drive index\u2026\nEvaluating your compatibility with capital
      logic\u2026\nAnalyzing your tolerance for algorithmic intervention\u2026\nMeasuring
      your emotional suppression threshold\u2026"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026\nCalculating
      your engagement drive index\u2026\nEvaluating your compatibility with capital
      logic\u2026\nAnalyzing your tolerance for algorithmic intervention\u2026\nMeasuring
      your emotional suppression threshold\u2026\nProjecting your governance efficiency
      and conversion rate\u2026\n"
    choices: []
  - text: "System Calculating\u2026\n\nCalculating your visibility orientation\u2026\nCalculating
      your engagement drive index\u2026\nEvaluating your compatibility with capital
      logic\u2026\nAnalyzing your tolerance for algorithmic intervention\u2026\nMeasuring
      your emotional suppression threshold\u2026\nProjecting your governance efficiency
      and conversion rate\u2026\nProjecting your governance efficiency and conversion
      rate\u2026\n......\n\n"
    choices: []
  - text: 'Please wait.

'
    choices: []
